{
  "name": "blank",
  "private": true,
  "version": "0.2.13",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "vite --open /website.html",
    "build": "vue-tsc --noEmit && vite build",
    "build:website": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:website": "vite preview --open /website.html",
    "tauri": "tauri",
    "build:mac": "tauri build && bash scripts/collect-dmg.sh",
    "build:mac:arm64": "tauri build --target aarch64-apple-darwin && bash scripts/collect-dmg.sh Sheaf-macos-arm64.dmg",
    "build:mac:x64": "tauri build --target x86_64-apple-darwin && bash scripts/collect-dmg.sh Sheaf-macos-x64.dmg",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.17.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ai": "^6.0.196",
    "codemirror": "^6.0.2",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "mermaid": "^11.15.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
