{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "allow-take-opened-files",
    "allow-open-dropped-files",
    "allow-export-pdf-file",
    "allow-fetch-url",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    },
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-text"
  ]
}
